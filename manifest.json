{
  "manifest_version": 3,
  "name": "Easy Prompt Builder",
  "version": "1.0",
  "description": "Build LLM-friendly prompts.",
  "permissions": ["clipboardWrite"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
